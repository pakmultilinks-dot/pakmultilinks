# PostgreSQL connection used by Prisma. Replace every placeholder before production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pak_multilinks?schema=public"

# Generate a long random value (at least 32 characters).
AUTH_SECRET="replace-with-a-long-random-secret"

# Bootstrap admin credentials. ADMIN_PASSWORD is accepted in development only.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-for-local-development"
# In production, store a bcrypt hash instead:
ADMIN_PASSWORD_HASH=""

# Public canonical site origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional search-engine ownership verification values.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
FACEBOOK_DOMAIN_VERIFICATION=""

# Optional measurement ID. Enable only after analytics/privacy approval.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Leave empty until the business confirms its WhatsApp number.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional production integrations. Leave disabled until verified.
ENABLE_BANK_TRANSFER="false"
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_SECRET=""

# Optional chatbot integration (server-side only).
# Endpoint receives POST { "messages": [{ "role": "user", "content": "Hello" }] }
# and must return JSON { "reply": "How can we help?" }.
# CHATBOT_API_KEY is sent as Authorization: Bearer <key> when set.
# Leave URL blank to show the friendly contact fallback until connected.
CHATBOT_API_URL=""
CHATBOT_API_KEY=""
