generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_TRANSFER
  PAID
  FAILED
  REFUNDED
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole             @default(CUSTOMER)
  isActive      Boolean              @default(true)
  emailVerified DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]

  @@index([role, isActive])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Delivery")
  fullName   String
  phone      String
  company    String?
  province   String
  city       String
  line1      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([name])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, name])
}

model Product {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  sku                 String             @unique
  shortDescription    String?
  description         String
  price               Decimal            @db.Decimal(12, 2)
  salePrice           Decimal?           @db.Decimal(12, 2)
  priceOnRequest      Boolean            @default(false)
  unitsPerCarton      Int                @default(0)
  minimumOrderCartons Int                @default(1)
  stock               Int                @default(0)
  soldQuantity        Int                @default(0)
  lowStockThreshold   Int                @default(5)
  allowBackorder      Boolean            @default(false)
  featured            Boolean            @default(false)
  bestSeller          Boolean            @default(false)
  bulkPricing         Boolean            @default(false)
  status              ProductStatus      @default(DRAFT)
  categoryId          String
  brandId             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand               Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  attributes          ProductAttribute[]
  variants            ProductVariant[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  quoteItems          QuoteRequestItem[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([status, featured])
  @@index([status, bestSeller])
  @@index([stock])
  @@index([createdAt])
}

model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  label               String
  sku                 String      @unique
  price               Decimal     @db.Decimal(12, 2)
  salePrice           Decimal?    @db.Decimal(12, 2)
  unitsPerCarton      Int         @default(1)
  minimumOrderCartons Int         @default(1)
  stock               Int         @default(0)
  imageUrl            String?
  sortOrder           Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([productId, sortOrder])
  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  sessionKey String?    @unique
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId, productId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String
  companyName   String?
  ntn           String?
  province      String
  city          String
  address       String
  postalCode    String?
  notes         String?
  subtotal      Decimal       @db.Decimal(12, 2)
  deliveryFee   Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  requiresQuote Boolean       @default(false)
  currency      String        @default("PKR")
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  variantLabel String?
  variantSku   String?
  productName  String
  sku          String
  imageUrl     String?
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal         @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model QuoteRequest {
  id           String             @id @default(cuid())
  quoteNumber  String             @unique
  customerName String
  companyName  String
  phone        String
  email        String
  city         String
  notes        String?
  status       QuoteStatus        @default(NEW)
  adminNotes   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        QuoteRequestItem[]

  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model QuoteRequestItem {
  id          String       @id @default(cuid())
  quoteId     String
  productId   String?
  productName String
  quantity    Int
  details     String?
  quote       QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

model SiteSettings {
  id                  String   @id @default("main")
  businessName        String   @default("Pak Multilinks Hygiene")
  subtitle            String   @default("Corporate Supplies")
  tagline             String   @default("Your Hygiene Partner")
  logoUrl             String?
  phone               String   @default("0317 1678829")
  email               String   @default("bilalshah2237463@gmail.com")
  address             String   @default("Shop No LG-9, Rehman Tower Main Market Gulberg II, Lahore")
  whatsapp            String?
  currency            String   @default("PKR")
  taxRate             Decimal  @default(0) @db.Decimal(5, 2)
  bankTransferEnabled Boolean  @default(false)
  deliveryInformation String?
  announcement        String?
  homepageBannerUrl   String?
  facebookUrl         String?
  instagramUrl        String?
  linkedinUrl         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DealBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  alt       String?
  linkUrl   String?  @default("/shop")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateListFile {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  category    String   @default("Master Rate List")
  documentType String  @default("RATE_LIST")
  coverStyle   String  @default("HYGIENE")
  coverImageUrl String?
  fileUrl     String
  fileName    String
  fileSize    Int      @default(0)
  pageCount   Int?     @default(1)
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
  @@index([isPrimary])
  @@index([createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  category    String   @default("Buying Guide")
  imageUrl    String?
  imageAlt    String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

